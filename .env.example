### Copy .env.example to .env to adjust infer/Embeat.py settings ###

# Qdrant vector database URL
EMBEAT_QDRANT_URL=http://127.0.0.1:6333
# Qdrant API key (leave empty if not set)
EMBEAT_QDRANT_API_KEY=
# Qdrant collection name
EMBEAT_COLLECTION_NAME=spotify_tracks
# Qdrant connection timeout in seconds
EMBEAT_QDRANT_TIMEOUT=30
# Track2Vec wv file path
EMBEAT_TRACK2VEC_PATH=checkpoints/Track2Vec/track2vec.wv
# Enable low-RAM mode in Qdrant payload indexing (move some payload on disk)
EMBEAT_ENABLE_LOW_RAM=0
# Enable track name search (fully indexing required)
EMBEAT_ENABLE_NAME_SEARCH=1
# Enable verbose debug logging
EMBEAT_VERBOSE_LOG=1
# Convert Simplified Chinese keywords to Traditional Chinese
EMBEAT_ZHCONV=0
# Use artist-level aggregated genre (0) or track-level estimated genre (1)
EMBEAT_USE_TRACK_GENRE=1
# Remove result items without ISRC
EMBEAT_IS_FILTER_NO_ISRC=1
# Minimum popularity threshold to filter out low-popularity tracks
EMBEAT_MIN_POPULARITY=0.1
# Ratio of same-genre popular tracks as fallback in results
EMBEAT_POPULAR_RATIO=0.1
# Minimum similarity threshold for playlist collaborative filtering recall
EMBEAT_MIN_RELATED_TRACK_SCORE=0.75
# Track2Vec votes override a track's artist_genre_idx only if the top genre outscores the runner-up by this factor
EMBEAT_TRACK_GENRE_SCORE_RATIO=2.0
# Random seed for fixed results: int > 0 means same output for the same query, 0 means random on every call
EMBEAT_RANDOM_SEED=0
# Ratio range for same-artist tracks in results
EMBEAT_SAME_ARTIST_RATIO_RANGE=0.15,0.2
# Weight range for acoustic similarity recall channel
EMBEAT_RECALL_SIMILAR_WEIGHTS=1.7,1.0
# Weight range for same-genre popular recall channel
EMBEAT_RECALL_POPULAR_WEIGHTS=1.0,0.8
# Weight range for same-artist recall channel
EMBEAT_RECALL_SAME_ARTIST_WEIGHTS=1.9,1.0
# Weight range for similar-artist recall channel
EMBEAT_RECALL_RELATED_ARTIST_WEIGHTS=1.8,1.0
# Weight range for playlist collaborative filtering recall channel
EMBEAT_RECALL_RELATED_TRACK_WEIGHTS=2.0,1.2
# OpenRouter API Key for "Embeat vs Netease" evaluation usage
OPENROUTER_API_KEY=
# Requests proxy for "Embeat vs Netease" evaluation usage
EVAL_PROXY_URL=
